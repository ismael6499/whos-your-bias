<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainAppRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/rootMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

    <!-- Clean Minimalist Top Header (Vibrary + Moshicam style) -->
    <LinearLayout
        android:id="@+id/topHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitleHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#111827"
                android:textSize="21sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <!-- Vibrary Golden Underline Accent -->
            <View
                android:id="@+id/viewHeaderUnderline"
                android:layout_width="48dp"
                android:layout_height="3.5dp"
                android:layout_marginTop="3dp"
                android:background="#FFC700" />
        </LinearLayout>

        <!-- Theme Customization Button (moved to My Page) -->
        <TextView
            android:id="@+id/btnOpenThemeStudio"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Compact Pill Music Bar (Click title to pick song, Play/Pause, Mute) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_chip_tag">

            <TextView
                android:id="@+id/tvBgmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="135dp"
                android:text="🍬 ILLIT - Jellyous"
                android:textColor="#111827"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnBgmPlayPause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="⏸"
                android:textColor="#111827"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnBgmMute"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="🔊"
                android:textColor="#111827"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnBgmVideoToggle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="📺"
                android:textColor="#111827"
                android:textSize="11sp"
                android:background="@drawable/bg_btn_gold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnBgmChangeSong"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Hidden legacy IDs for compatibility -->
        <TextView
            android:id="@+id/btnHeaderGacha"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnHeaderImport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Main Dynamic Content Container -->
    <FrameLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <!-- Vibrary + Moshicam Bottom Bar with Center Circular '+' Button -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tabBtnArena"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_tab_arena"
            android:textColor="#111827"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tabBtnIdols"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_tab_idols"
            android:textColor="#9CA3AF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp" />

        <!-- Center Moshicam '+' Floating Action Button -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05">

            <TextView
                android:id="@+id/btnCenterPlus"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="+"
                android:textColor="#111827"
                android:textSize="28sp"
                android:textStyle="bold"
                android:elevation="6dp"
                android:background="@drawable/bg_btn_gold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tabBtnGroups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_tab_artists"
            android:textColor="#9CA3AF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tabBtnHallOfFame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_tab_profile"
            android:textColor="#9CA3AF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    </LinearLayout>

    <!-- Foreground Floating YouTube Mini Player Card (16:9 PiP) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bgmVideoContainer"
        android:layout_width="180dp"
        android:layout_height="124dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="72dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#111827"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top Drag Handle Bar -->
            <LinearLayout
                android:id="@+id/miniPlayerDragBar"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1E293B"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:clickable="true"
                android:focusable="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⠿ Drag / Mover"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Close Floating Mini Player Button -->
                <TextView
                    android:id="@+id/btnMiniPlayerClose"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="false" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/bgmWebViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
