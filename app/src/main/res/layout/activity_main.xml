<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark_primary">

    <!-- Top Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_dark_surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnHeaderGacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 Gacha"
            android:textColor="@color/bg_dark_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_gold" />

        <TextView
            android:id="@+id/btnHeaderImport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥 Import"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_btn_secondary" />
    </LinearLayout>

    <!-- YouTube Background Music Mini-Player Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111626"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBgmTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bgm_now_playing"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="marquee" />

            <TextView
                android:id="@+id/btnBgmPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bgm_play"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_chip_tag" />

            <TextView
                android:id="@+id/btnBgmMute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bgm_unmute"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_chip_tag" />

            <TextView
                android:id="@+id/btnBgmVideoToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bgm_video_toggle"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_chip_tag" />

            <TextView
                android:id="@+id/btnBgmChangeSong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bgm_change_song"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_chip_tag" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bgmVideoContainer"
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <WebView
                android:id="@+id/bgmWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_glass" />

    <!-- Main Dynamic Tab Content Area -->
    <FrameLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_glass" />

    <!-- Sleek Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/bg_dark_surface"
        android:gravity="center">

        <TextView
            android:id="@+id/tabBtnArena"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚡ Arena"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabBtnIdols"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🃏 Idols"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabBtnGroups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✨ Groups"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabBtnHallOfFame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👑 Hall of Fame"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
