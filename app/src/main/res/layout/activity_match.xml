<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/matchRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Clean Minimalist Match Top Bar -->
        <LinearLayout
            android:id="@+id/matchTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/btnExitMatch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_tag" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvMatchTournamentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Who's your Bias"
                    android:textColor="#6B7280"
                    android:textSize="11.5sp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvMatchRoundBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROUND OF 16 • 1/8"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Compact Music Controls in Arena -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_chip_tag">

                <TextView
                    android:id="@+id/tvMatchBgmTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="95dp"
                    android:text="🎵 BGM"
                    android:textColor="#111827"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnMatchBgmPlayPause"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="⏸"
                    android:textColor="#111827"
                    android:textSize="11sp"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/btnMatchBgmMute"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="🔊"
                    android:textColor="#111827"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnMatchBgmVideo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="3dp"
                    android:gravity="center"
                    android:text="📺"
                    android:textColor="#111827"
                    android:textSize="11sp"
                    android:background="@drawable/bg_btn_gold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLightstickCheer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnMatchBgmSong"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Golden Match Progress Bar -->
        <ProgressBar
            android:id="@+id/matchProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="15"
            android:progressTint="#FFC700"
            android:progressBackgroundTint="#F3F4F6" />

        <!-- SPACIOUS 1v1 DUEL ARENA -->
        <LinearLayout
            android:id="@+id/arenaDuelContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <!-- CARD 1 (TOP CONTENDER) -->
            <FrameLayout
                android:id="@+id/cardSlotTop"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- CLEAN VS BADGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E5E7EB" />

                <TextView
                    android:id="@+id/tvVsBadge"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="VS"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_btn_primary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E5E7EB" />
            </LinearLayout>

            <!-- CARD 2 (BOTTOM CONTENDER) -->
            <FrameLayout
                android:id="@+id/cardSlotBottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- VICTORY CORONATION VIEW -->
        <ScrollView
            android:id="@+id/victoryScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/victoryContentBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:gravity="center_horizontal" />
        </ScrollView>

    </LinearLayout>

    <com.nitsutech.whosyourbias.ui.ConfettiView
        android:id="@+id/confettiOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Foreground Floating YouTube Mini Player Card (16:9 PiP) in Match -->
    <androidx.cardview.widget.CardView
        android:id="@+id/matchBgmVideoContainer"
        android:layout_width="168dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="14dp"
        app:cardBackgroundColor="#000000"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/matchBgmWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Close Floating Mini Player Button -->
            <TextView
                android:id="@+id/btnMatchMiniPlayerClose"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
